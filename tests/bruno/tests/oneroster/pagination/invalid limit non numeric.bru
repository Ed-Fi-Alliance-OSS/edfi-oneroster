meta {
  name: invalid limit - non numeric
  type: http
  seq: 6
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/users?limit=abc&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-odsApiToken}}
}

script:pre-request {
  const token = bru.getEnvVar('lea-odsApiToken');
  if (!token) {
    throw new Error('Run the oauth folder to populate accessToken before calling OneRoster endpoints.');
  }
}

tests {
  test("non numeric limit is rejected with 400", function() {
    // Previously this dropped the LIMIT clause entirely and returned the whole view.
    expect(res.getStatus()).to.equal(400);
  });

  test("error uses the imsx envelope", function() {
    const body = res.getBody();
    expect(body.imsx_codeMajor).to.equal('failure');
    expect(body.imsx_severity).to.equal('error');
    expect(body.imsx_codeMinor).to.equal('invalid_data');
    expect(body.imsx_description).to.be.a('string');
  });

  test("no collection is returned alongside the error", function() {
    expect(res.getBody()?.users).to.be.undefined;
  });
}
