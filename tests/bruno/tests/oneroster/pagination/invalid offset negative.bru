meta {
  name: invalid offset - negative
  type: http
  seq: 13
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/users?limit=5&offset=-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-odsApiToken}}
}

script:pre-request {
  const token = bru.getEnvVar('lea-odsApiToken');
  if (!token) {
    throw new Error('Run the oauth folder to populate accessToken before calling OneRoster endpoints.');
  }
}

tests {
  test("negative offset is a client error, not a 500", function() {
    // Previously knex threw and the request surfaced as an internal server error.
    expect(res.getStatus()).to.equal(400);
  });

  test("error uses the imsx envelope", function() {
    const body = res.getBody();
    expect(body.imsx_codeMajor).to.equal('failure');
    expect(body.imsx_severity).to.equal('error');
    expect(body.imsx_codeMinor).to.equal('invalid_data');
  });

  test("no database detail is leaked", function() {
    const description = res.getBody()?.imsx_description || '';
    expect(description.toLowerCase()).to.not.include('non-negative integer must be provided');
  });
}
