meta {
  name: explicit limit is honored
  type: http
  seq: 2
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/users?limit=5&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-odsApiToken}}
}

script:pre-request {
  const token = bru.getEnvVar('lea-odsApiToken');
  if (!token) {
    throw new Error('Run the oauth folder to populate accessToken before calling OneRoster endpoints.');
  }
}

tests {
  test("request succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns no more than the requested limit", function() {
    const users = res.getBody()?.users;
    expect(users).to.be.an('array');
    expect(users.length).to.be.at.most(5);
    console.log("records returned for limit=5: " + users.length);
  });

  test("limit is not silently truncated to a single record", function() {
    const users = res.getBody()?.users;
    // Guards the parseInt('1e3') === 1 class of bug: a valid limit must not collapse to 1
    // when the dataset is large enough to fill the page.
    expect(users.length).to.be.above(1);
  });
}
