meta {
  name: invalid limit - negative
  type: http
  seq: 8
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/users?limit=-1&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-odsApiToken}}
}

script:pre-request {
  const token = bru.getEnvVar('lea-odsApiToken');
  if (!token) {
    throw new Error('Run the oauth folder to populate accessToken before calling OneRoster endpoints.');
  }
}

tests {
  test("negative limit is a client error, not a 500", function() {
    // Previously reached the database and surfaced as an internal server error.
    expect(res.getStatus()).to.equal(400);
  });

  test("error uses the imsx envelope", function() {
    const body = res.getBody();
    expect(body.imsx_codeMajor).to.equal('failure');
    expect(body.imsx_severity).to.equal('error');
    expect(body.imsx_codeMinor).to.equal('invalid_data');
  });

  test("no database detail is leaked", function() {
    const description = res.getBody()?.imsx_description || '';
    expect(description.toLowerCase()).to.not.include('select');
    expect(description.toLowerCase()).to.not.include('knex');
  });
}
