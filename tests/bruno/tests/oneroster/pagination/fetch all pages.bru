meta {
  name: fetch all pages
  type: http
  seq: 14
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/users?limit=100&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-odsApiToken}}
}

script:pre-request {
  const token = bru.getEnvVar('lea-odsApiToken');
  if (!token) {
    throw new Error('Run the oauth folder to populate accessToken before calling OneRoster endpoints.');
  }
}

tests {
  // This request fetches the first page; the rest are fetched here with
  // bru.sendRequest, so the whole walk is one request in the test report.
  const PAGE_SIZE = 100;
  // Safety valve: stop after this many pages even if the view keeps producing full
  // pages, so a paging regression cannot spin the suite forever.
  const MAX_PAGES = 200;

  const usersUrl = `${bru.getEnvVar('oneRosterUrl')}/${bru.getEnvVar('rosterPath')}/users`;
  const headers = { Authorization: `Bearer ${bru.getEnvVar('lea-odsApiToken')}` };

  const firstPage = res.getBody()?.users || [];
  const pageSizes = [firstPage.length];
  const ids = firstPage.map(u => u.sourcedId);
  let pageError = null;
  let lastPageSize = firstPage.length;

  while (res.getStatus() === 200 && lastPageSize === PAGE_SIZE && pageSizes.length < MAX_PAGES) {
    const offset = pageSizes.length * PAGE_SIZE;
    try {
      const page = await bru.sendRequest({
        method: 'GET',
        url: `${usersUrl}?limit=${PAGE_SIZE}&offset=${offset}`,
        headers
      });
      if (page.status !== 200) {
        pageError = `offset ${offset} returned HTTP ${page.status}`;
        break;
      }
      const users = page.data?.users || [];
      pageSizes.push(users.length);
      ids.push(...users.map(u => u.sourcedId));
      lastPageSize = users.length;
    } catch (err) {
      pageError = `offset ${offset} failed: ${err.response ? 'HTTP ' + err.response.status : err.message}`;
      break;
    }
  }

  const truncated = pageError === null && lastPageSize === PAGE_SIZE && pageSizes.length >= MAX_PAGES;
  console.log("paged through " + pageSizes.length + " page(s), " + ids.length + " record(s) total");

  test("first page request succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("every following page request succeeded", function() {
    expect(pageError, pageError || '').to.equal(null);
  });

  test("no page is larger than the requested size", function() {
    expect(Math.max(...pageSizes)).to.be.at.most(PAGE_SIZE);
  });

  test("paging terminated without hitting the safety valve", function() {
    expect(truncated).to.equal(false);
  });

  test("paging returned every record exactly once", function() {
    expect(new Set(ids).size).to.equal(ids.length);
  });

  test("paged total matches the single request total", function() {
    const singleShot = Number(bru.getVar('usersSingleShotCount'));

    if (!Number.isFinite(singleShot)) {
      console.log("no single-request baseline available; run the users folder first");
      return;
    }

    // The baseline is only a valid total if it was not truncated - either by its own
    // limit or by the server's ceiling, whichever bites first. When MAX_PAGE_SIZE is
    // lower than the baseline request's limit, the response is silently clamped, so
    // comparing against it would be comparing against a partial view.
    const effectiveLimit = Math.min(
      Number(bru.getVar('usersSingleShotLimit')),
      Number(bru.getEnvVar('maxPageSize')) || 500
    );

    if (singleShot >= effectiveLimit) {
      console.log("single-request baseline was capped at " + effectiveLimit + "; skipping comparison");
      return;
    }

    expect(ids.length).to.equal(singleShot);
  });
}
