meta {
  name: roster-core.readonly access
  type: http
  seq: 1
}

post {
  url: {{oauthUrl}}
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{leaClientId}}",
    "client_secret": "{{leaClientSecret}}",
    "scope": "{{scopeRosterCore}}"
  }
}

tests {
  // The request gets the token; runScopeAccess checks it holds exactly these
  // scopes, then calls every endpoint in lib/access-matrix.js with it.
  const { runScopeAccess } = require('./lib/scope-access.js');
  await runScopeAccess({ label: 'roster-core.readonly', scopes: ['rosterCore'], res, bru, test, expect });
}

settings {
  encodeUrl: true
  timeout: 0
}
