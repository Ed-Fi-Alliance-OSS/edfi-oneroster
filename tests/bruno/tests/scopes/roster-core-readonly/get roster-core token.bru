meta {
  name: get roster-core token
  type: http
  seq: 1
}

post {
  url: {{oauthUrl}}
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{leaClientId}}",
    "client_secret": "{{leaClientSecret}}",
    "scope": "{{scopeRosterCore}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar('lea-rosterCoreToken', res.getBody().access_token);
  }
}

tests {
  test("token issued", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()?.access_token).to.be.a('string').and.not.empty;
  });

  test("token holds only the roster-core.readonly scope", function() {
    const granted = (res.getBody()?.scope || '').split(/\s+/).filter(Boolean);
    expect(granted).to.deep.equal([bru.getCollectionVar('scopeRosterCore')]);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
