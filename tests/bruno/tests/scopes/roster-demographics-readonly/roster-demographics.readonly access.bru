meta {
  name: roster-demographics.readonly access
  type: http
  seq: 1
}

post {
  url: {{oauthUrl}}
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{leaClientId}}",
    "client_secret": "{{leaClientSecret}}",
    "scope": "{{scopeRosterDemographics}}"
  }
}

tests {
  // The request gets the token; runAccessMatrix checks it holds exactly these
  // scopes, then calls every endpoint in lib/access-matrix.js with it.
  const { runAccessMatrix } = require('./lib/scope-access.js');
  await runAccessMatrix(test, expect, bru, { label: 'roster-demographics.readonly', scopes: ['rosterDemographics'], res });
}

settings {
  encodeUrl: true
  timeout: 0
}
