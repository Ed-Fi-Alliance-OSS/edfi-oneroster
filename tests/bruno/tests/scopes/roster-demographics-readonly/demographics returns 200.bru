meta {
  name: demographics returns 200
  type: http
  seq: 2
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/demographics?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-rosterDemographicsToken}}
}

script:pre-request {
  if (!bru.getEnvVar('lea-rosterDemographicsToken')) {
    throw new Error("Run 'get roster-demographics token' first to populate lea-rosterDemographicsToken.");
  }
}

tests {
  test("returns HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the demographics collection", function() {
    expect(res.getBody()?.demographics).to.be.an('array');
  });
}
