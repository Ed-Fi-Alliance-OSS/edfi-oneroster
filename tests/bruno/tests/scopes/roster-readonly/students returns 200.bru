meta {
  name: students returns 200
  type: http
  seq: 11
}

get {
  url: {{oneRosterUrl}}/{{rosterPath}}/students?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{lea-rosterToken}}
}

script:pre-request {
  if (!bru.getEnvVar('lea-rosterToken')) {
    throw new Error("Run 'get roster token' first to populate lea-rosterToken.");
  }
}

tests {
  test("returns HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the users collection", function() {
    expect(res.getBody()?.users).to.be.an('array');
  });
}
