# =============================================================================
# OneRoster Deployment Environment Configuration Example
# =============================================================================
#
# Copy this file and rename it to .env.deploy in the same folder (standard/):
#
#   cp standard/.env.deploy.example standard/.env.deploy
#
# Both deploy-mssql.js and deploy-pgsql.js read from standard/.env.deploy.
# Fill in the values for the database engine you are deploying to and leave
# the other section commented out.
# =============================================================================

# MSSQL required variables

DB_HOST=localhost
DB_PORT=1433
DB_NAME=EdFi_Ods
DB_USER=sa
DB_PASS=<your_db_password>

# Connections are encrypted with certificate validation by default.
# A local SQL Server presents a self-signed certificate, so skip validation
# while keeping traffic encrypted:
DB_TRUST_SERVER_CERTIFICATE=true

# Disables encryption entirely. Local development only — leave commented unless
# the server has no usable TLS certificate.
# DB_ENCRYPT=false

# For a server fronted by an internal or enterprise CA, supply the CA instead of
# skipping validation. Preferred over DB_TRUST_SERVER_CERTIFICATE for production.
# DB_SSL_CA=/path/to/ca.pem

# PostgreSQL required variables

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=EdFi_Ods
# DB_USER=postgres
# DB_PASS=<your_db_password>
# DB_SSL=false
# PG_STATEMENT_TIMEOUT=120000
